{
  "mcpServers": {
    "filesystem": {
      "args": [
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "command": "bunx",
      "type": "stdio"
    },
    "git": {
      "args": [
        "mcp-server-git"
      ],
      "command": "uvx",
      "type": "stdio"
    },
    "sequential-thinking": {
      "args": [
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "command": "bunx",
      "env": {},
      "type": "stdio"
    },
    "dart": {
      "command": "dart",
      "args": ["mcp-server"]
    }
    
  }
}
