# Copy to `.env` and adjust as needed:  cp .env.example .env

# Android Emulator: http://10.0.2.2:8085/v1
# Web / Windows / iOS Simulator: http://localhost:8085/v1
BASE_URL=http://localhost:8085/v1
WEB_BASE_URL=http://localhost:3000

# Production URLs:
# BASE_URL=https://api.fuve.vn/api/general/v1
# WEB_BASE_URL=https://fuve.vn
# Web OAuth client ID (same as Fuvekon NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
