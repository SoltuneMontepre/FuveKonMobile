# Copy to `.env` and adjust as needed:  cp .env.example .env

# Android Emulator: http://10.0.2.2:8085/v1
# Physical device on LAN: http://<your-pc-lan-ip>:8085/v1
# Web / Windows / iOS Simulator: http://localhost:8085/v1
BASE_URL=http://localhost:8085/v1
WEB_BASE_URL=http://localhost:3000

# Optional: documents the LocalStack origin your device must reach for S3 PUT.
# Update general-service LOCALSTACK_ENDPOINT / S3_BUCKET_URL to the same LAN host.
# S3_UPLOAD_ENDPOINT=http://192.168.1.10:4566

# Production URLs:
# BASE_URL=https://api.fuve.vn/api/general/v1
# WEB_BASE_URL=https://fuve.vn
# Web OAuth client ID (same as Fuvekon NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
