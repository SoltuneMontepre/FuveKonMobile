# Flutter mobile app — copy to `.env` in the project root.
BASE_URL=https://api.fuve.vn/api/general/v1
WEB_BASE_URL=https://fuve.vn

# Google OAuth web client ID (same as NEXT_PUBLIC_GOOGLE_CLIENT_ID on Fuvekon web).
# Leave empty to hide Google Sign-In and run without OAuth on local/web dev.
GOOGLE_CLIENT_ID=

# Mock ticket flow locally without calling ticket APIs (demo / production read-only).
# Omit or set false to use real ticket API. Defaults to true in debug builds.
MOCK_TICKET_MODE=true
