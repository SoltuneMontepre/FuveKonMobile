# Docker Compose Environment Variables
# Copy this file to '.env' in the same directory to customize your local infrastructure

# --- LocalStack Configuration ---
# Version of the LocalStack image to pull and run
LOCALSTACK_IMAGE=localstack/localstack:4.14.0

# Persist LocalStack state and data between container restarts (1 = Enabled, 0 = Disabled)
PERSISTENCE=0

# AWS Services to enable in LocalStack (separated by commas)
# Add 'lambda' if you plan to emulate AWS Lambda locally
LOCALSTACK_SERVICES=s3,sqs,ses,lambda

# Enable local AWS Lambda deployments inside LocalStack (1 = Enabled, 0 = Disabled)
# IMPORTANT: If set to 1, you MUST build the bootstrap.zip packages using `task build:local` 
# or `task build:lambda` before starting the containers, so that LocalStack can deploy them.
ENABLE_LOCALSTACK_LAMBDA=0
